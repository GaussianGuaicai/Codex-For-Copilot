+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { URI } from '../../../../base/common/uri.js';
+
+export interface IChatSessionConfigurationSelection {
+	readonly sessionResource: URI;
+	readonly modelId: string;
+	readonly configuration: Readonly<{ reasoningEffort?: string }>;
+}
+
+/** Prototype chatProvider context, scoped to a verified user turn, not an individual model call. */
+export interface ILanguageModelChatSessionContext {
+	readonly protocolVersion: 1;
+	readonly sessionId: string;
+	readonly taskId: string;
+	readonly revision: number;
+	readonly state: 'running' | 'ended';
+	readonly source: 'request' | 'user' | 'lifecycle';
+	readonly configuration: Readonly<{ reasoningEffort?: string }>;
+}
+
+/** Retains only routing/selection metadata; no messages, tools or response content. */
+export class ChatSessionConfigurationTracker {
+	private readonly tasks = new Map<string, { modelId: string; context: ILanguageModelChatSessionContext }>();
+
+	constructor(private readonly notify: (modelId: string, context: ILanguageModelChatSessionContext) => void) { }
+
+	track(sessionId: string, taskId: string, modelId: string, configuration: ILanguageModelChatSessionContext['configuration']): ILanguageModelChatSessionContext {
+		const existing = this.tasks.get(sessionId);
+		if (existing?.context.taskId === taskId && existing.modelId === modelId) {
+			return { ...existing.context, source: 'request' };
+		}
+		if (existing) {
+			this.end(sessionId, existing.context.taskId);
+		}
+		const context: ILanguageModelChatSessionContext = { protocolVersion: 1, sessionId, taskId, revision: 0, state: 'running', source: 'request', configuration: { ...configuration } };
+		this.tasks.set(sessionId, { modelId, context });
+		return context;
+	}
+
+	select(sessionId: string, taskId: string, modelId: string, configuration: ILanguageModelChatSessionContext['configuration']): void {
+		const task = this.tasks.get(sessionId);
+		if (!task || task.context.taskId !== taskId) {
+			return;
+		}
+		if (task.modelId !== modelId) {
+			this.end(sessionId, taskId);
+			return;
+		}
+		if (task.context.configuration.reasoningEffort === configuration.reasoningEffort) {
+			return;
+		}
+		task.context = { ...task.context, revision: task.context.revision + 1, source: 'user', configuration: { ...configuration } };
+		this.notify(modelId, task.context);
+	}
+
+	end(sessionId: string, taskId: string): void {
+		const task = this.tasks.get(sessionId);
+		if (task?.context.taskId !== taskId) {
+			return;
+		}
+		this.tasks.delete(sessionId);
+		this.notify(task.modelId, { ...task.context, state: 'ended', source: 'lifecycle' });
+	}
+
+	dispose(): void {
+		for (const [sessionId, task] of this.tasks) {
+			this.end(sessionId, task.context.taskId);
+		}
+	}
+}
