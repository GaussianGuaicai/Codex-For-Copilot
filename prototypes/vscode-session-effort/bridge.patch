+suite('ChatSessionConfigurationTracker', () => {
+	const store = ensureNoDisposablesAreLeakedInTestSuite();
+	test('routes explicit selections only to the originating model and task', () => {
+		const events: [string, ILanguageModelChatSessionContext][] = [];
+		const tracker = store.add(new ChatSessionConfigurationTracker((model, context) => events.push([model, context])));
+		tracker.track('session-a', 'task-a', 'same-model', { reasoningEffort: 'low' });
+		tracker.track('session-b', 'task-b', 'same-model', { reasoningEffort: 'medium' });
+		tracker.select('session-a', 'task-a', 'same-model', { reasoningEffort: 'high' });
+		tracker.select('session-a', 'task-a', 'same-model', { reasoningEffort: 'high' });
+		tracker.select('session-a', 'other-task', 'same-model', { reasoningEffort: 'none' });
+		assert.deepStrictEqual(events, [['same-model', {
+			protocolVersion: 1, sessionId: 'session-a', taskId: 'task-a', revision: 1,
+			state: 'running', source: 'user', configuration: { reasoningEffort: 'high' }
+		}]]);
+		assert.strictEqual(tracker.track('session-b', 'task-b', 'same-model', {}).revision, 0);
+	});
+
+	test('tool continuations retain the latest revision despite stale configuration', () => {
+		const tracker = store.add(new ChatSessionConfigurationTracker(() => { }));
+		tracker.track('session', 'task', 'model', { reasoningEffort: 'low' });
+		tracker.select('session', 'task', 'model', { reasoningEffort: 'high' });
+		assert.deepStrictEqual(tracker.track('session', 'task', 'model', { reasoningEffort: 'low' }), {
+			protocolVersion: 1, sessionId: 'session', taskId: 'task', revision: 1,
+			state: 'running', source: 'request', configuration: { reasoningEffort: 'high' }
+		});
+	});
+
+	test('model switches and task completion retire the original association', () => {
+		const states: string[] = [];
+		const tracker = store.add(new ChatSessionConfigurationTracker((_model, context) => states.push(context.state)));
+		tracker.track('session', 'task', 'model', {});
+		tracker.select('session', 'task', 'other-model', {});
+		tracker.select('session', 'task', 'model', { reasoningEffort: 'high' });
+		tracker.end('session', 'task');
+		tracker.track('session', 'new-task', 'model', {});
+		tracker.end('session', 'old-task');
+		tracker.dispose();
+		assert.deepStrictEqual(states, ['ended', 'ended']);
+	});
+});
